ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi
# Nombre de sessions simultanées (en général 1 par GPU)
MAX_SESSIONS=1
# Durée maximale d'une session en minutes
MAX_MINUTES=120
# Adresse publique/IP du serveur, telle que vue par les joueurs
PUBLIC_HOST=localhost
# Premier port exposé pour les streams (un port par slot)
BASE_PORT=9000
PORT=3000
